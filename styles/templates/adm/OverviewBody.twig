{% include "overall_header.twig" %}

{# Dashboard content rendered inside legacy-content wrapper with dashboard-specific styling #}
<style>
/* Override legacy-content for dashboard page */
.admin-content > .legacy-content.is-dashboard {
    background: transparent;
    border: none;
    padding: 0;
    overflow: visible;
}
</style>
<script>document.querySelector('.legacy-content').classList.add('is-dashboard');</script>

<!-- Dashboard Header -->
<div class="dash-header">
    <h1>Dashboard</h1>
    <p>SmartMoons Administrationszentrum &mdash; Uni {{ uniName|default('1') }}</p>
</div>

<!-- Period Tabs -->
<div class="period-tabs">
    <button class="period-tab{% if period == 'day' %} active{% endif %}" data-period="day">Tag</button>
    <button class="period-tab{% if period == 'week' %} active{% endif %}" data-period="week">Woche</button>
    <button class="period-tab{% if period == 'month' %} active{% endif %}" data-period="month">Monat</button>
    <button class="period-tab{% if period == 'year' %} active{% endif %}" data-period="year">Jahr</button>
</div>

{% if Messages is defined and Messages is not empty %}
<div style="background:rgba(248,113,113,0.1);border:1px solid var(--adm-neon-red);border-radius:var(--adm-radius);padding:16px;margin-bottom:24px;">
    {% for Message in Messages %}
    <div style="color:var(--adm-neon-red);font-size:13px;margin-bottom:4px;">&#9888; {{ Message }}</div>
    {% endfor %}
</div>
{% endif %}

<!-- KPI Flipcards -->
<div class="flipcards-grid">
    <!-- Spieler Online -->
    <div class="flipcard" data-color="blue">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">Spieler Online</span>
                    <div class="flipcard-icon">&#128101;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-online">{{ report.players_online.online|default(0) }} <span class="sub">/ {{ report.players_online.total|default(0) }}</span></div>
                    <div class="flipcard-trend neutral">Online / Gesamt</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Details</div>
                <div class="flipcard-back-item"><span>Online (15 Min)</span><span class="flipcard-back-item-value">{{ report.players_online.online|default(0) }}</span></div>
                <div class="flipcard-back-item"><span>Gesamt registriert</span><span class="flipcard-back-item-value">{{ report.players_online.total|default(0) }}</span></div>
                <div class="flipcard-back-item"><span>Gesperrt</span><span class="flipcard-back-item-value">{{ report.banned_players.count|default(0) }}</span></div>
                <div class="flipcard-back-item"><span>Offene Tickets</span><span class="flipcard-back-item-value">{{ report.open_tickets.count|default(0) }}</span></div>
            </div>
        </div>
    </div>

    <!-- Registrierungen -->
    <div class="flipcard" data-color="green">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">Registrierungen</span>
                    <div class="flipcard-icon">&#128100;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-registrations">{{ report.registrations.count|default(0) }}</div>
                    <div class="flipcard-trend neutral">Im Zeitraum</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Registrierungen</div>
                <div class="flipcard-back-item"><span>Neue Spieler</span><span class="flipcard-back-item-value">{{ report.registrations.count|default(0) }}</span></div>
                <div class="flipcard-back-item"><span>Zeitraum</span><span class="flipcard-back-item-value">{{ period|default('day') }}</span></div>
            </div>
        </div>
    </div>

    <!-- Flotten -->
    <div class="flipcard" data-color="purple">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">Flotten gesendet</span>
                    <div class="flipcard-icon">&#128640;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-fleets">{% if report.fleets_sent.count is defined and report.fleets_sent.count >= 0 %}{{ report.fleets_sent.count }}{% else %}<span class="na-value">n/a</span>{% endif %}</div>
                    <div class="flipcard-trend neutral">Im Zeitraum</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Flotten Info</div>
                <div class="flipcard-back-item"><span>Gesendet</span><span class="flipcard-back-item-value">{% if report.fleets_sent.count is defined and report.fleets_sent.count >= 0 %}{{ report.fleets_sent.count }}{% else %}n/a{% endif %}</span></div>
                <div class="flipcard-back-item"><span>Aktuell fliegend</span><span class="flipcard-back-item-value">{% if report.flying_fleets.count is defined and report.flying_fleets.count >= 0 %}{{ report.flying_fleets.count }}{% else %}n/a{% endif %}</span></div>
            </div>
        </div>
    </div>

    <!-- Allianzen -->
    <div class="flipcard" data-color="cyan">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">Neue Allianzen</span>
                    <div class="flipcard-icon">&#127942;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-alliances">{% if report.alliances_founded.count is defined and report.alliances_founded.count >= 0 %}{{ report.alliances_founded.count }}{% else %}<span class="na-value">n/a</span>{% endif %}</div>
                    <div class="flipcard-trend neutral">Gegr&uuml;ndet</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Allianzen</div>
                <div class="flipcard-back-item"><span>Neue im Zeitraum</span><span class="flipcard-back-item-value">{% if report.alliances_founded.count is defined and report.alliances_founded.count >= 0 %}{{ report.alliances_founded.count }}{% else %}n/a{% endif %}</span></div>
                <div class="flipcard-back-item"><span>Gesamt</span><span class="flipcard-back-item-value">{% if report.alliances_total.count is defined and report.alliances_total.count >= 0 %}{{ report.alliances_total.count }}{% else %}n/a{% endif %}</span></div>
            </div>
        </div>
    </div>

    <!-- Kaempfe -->
    <div class="flipcard" data-color="red">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">K&auml;mpfe</span>
                    <div class="flipcard-icon">&#9876;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-combats">{% if report.combats.count is defined and report.combats.count >= 0 %}{{ report.combats.count }}{% else %}<span class="na-value">n/a</span>{% endif %}</div>
                    <div class="flipcard-trend neutral">Im Zeitraum</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Kampf-Details</div>
                <div class="flipcard-back-item"><span>K&auml;mpfe</span><span class="flipcard-back-item-value">{% if report.combats.count is defined and report.combats.count >= 0 %}{{ report.combats.count }}{% else %}n/a{% endif %}</span></div>
            </div>
        </div>
    </div>

    <!-- Nachrichten -->
    <div class="flipcard" data-color="yellow">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">Nachrichten</span>
                    <div class="flipcard-icon">&#9993;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-messages">{% if report.messages.count is defined and report.messages.count >= 0 %}{{ report.messages.count }}{% else %}<span class="na-value">n/a</span>{% endif %}</div>
                    <div class="flipcard-trend neutral">Im Zeitraum</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Nachrichten</div>
                <div class="flipcard-back-item"><span>Gesendet</span><span class="flipcard-back-item-value">{% if report.messages.count is defined and report.messages.count >= 0 %}{{ report.messages.count }}{% else %}n/a{% endif %}</span></div>
            </div>
        </div>
    </div>

    <!-- Multiaccount Flags -->
    <div class="flipcard" data-color="orange">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">Multi-Verdacht</span>
                    <div class="flipcard-icon">&#128279;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-multi">{% if report.multiaccount_flags.flagged_ips is defined and report.multiaccount_flags.flagged_ips >= 0 %}{{ report.multiaccount_flags.flagged_ips }}{% else %}<span class="na-value">n/a</span>{% endif %}</div>
                    <div class="flipcard-trend neutral">Geteilte IPs</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Multiaccount</div>
                <div class="flipcard-back-item"><span>Geteilte IPs</span><span class="flipcard-back-item-value">{% if report.multiaccount_flags.flagged_ips is defined and report.multiaccount_flags.flagged_ips >= 0 %}{{ report.multiaccount_flags.flagged_ips }}{% else %}n/a{% endif %}</span></div>
                <div class="flipcard-back-item"><span>Betroffene User</span><span class="flipcard-back-item-value">{% if report.multiaccount_flags.flagged_users is defined and report.multiaccount_flags.flagged_users >= 0 %}{{ report.multiaccount_flags.flagged_users }}{% else %}n/a{% endif %}</span></div>
            </div>
        </div>
    </div>

    <!-- Planeten -->
    <div class="flipcard" data-color="pink">
        <div class="flipcard-inner">
            <div class="flipcard-front">
                <div class="flipcard-front-top">
                    <span class="flipcard-label">Planeten</span>
                    <div class="flipcard-icon">&#127759;</div>
                </div>
                <div>
                    <div class="flipcard-value" id="kpi-planets">{% if report.planets_total.count is defined and report.planets_total.count >= 0 %}{{ report.planets_total.count }}{% else %}<span class="na-value">n/a</span>{% endif %}</div>
                    <div class="flipcard-trend neutral">Gesamt</div>
                </div>
            </div>
            <div class="flipcard-back">
                <div class="flipcard-back-title">Planeten</div>
                <div class="flipcard-back-item"><span>Gesamt</span><span class="flipcard-back-item-value">{% if report.planets_total.count is defined and report.planets_total.count >= 0 %}{{ report.planets_total.count }}{% else %}n/a{% endif %}</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="charts-grid">
    <div class="chart-card">
        <div class="chart-card-header">
            <div>
                <div class="chart-card-title">Aktivit&auml;t / Online Verlauf</div>
                <div class="chart-card-subtitle">Aktive Spieler im Zeitraum</div>
            </div>
        </div>
        <div class="chart-container">
            <canvas id="chartActivity"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-card-header">
            <div>
                <div class="chart-card-title">Registrierungen</div>
                <div class="chart-card-subtitle">Neue Spieler im Zeitraum</div>
            </div>
        </div>
        <div class="chart-container">
            <canvas id="chartRegistrations"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-card-header">
            <div>
                <div class="chart-card-title">Flottenstarts</div>
                <div class="chart-card-subtitle">Gestartete Flotten im Zeitraum</div>
            </div>
        </div>
        <div class="chart-container">
            <canvas id="chartFleets"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-card-header">
            <div>
                <div class="chart-card-title">K&auml;mpfe</div>
                <div class="chart-card-subtitle">Kampfberichte im Zeitraum</div>
            </div>
        </div>
        <div class="chart-container">
            <canvas id="chartCombats"></canvas>
        </div>
    </div>
</div>

<!-- Report / Bilanz Section -->
<div class="report-section">
    <div class="report-section-title">&#128202; Bilanz &mdash; {{ periodLabel|default('Heute') }}</div>
    <div class="report-grid">
        <!-- Zusammenfassung -->
        <div class="report-card">
            <div class="report-card-title">Zusammenfassung</div>
            <div class="report-row">
                <span class="report-row-label">Online Peak</span>
                <span class="report-row-value" id="rpt-online-peak">{{ report.players_online.online|default(0) }}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Neue Spieler</span>
                <span class="report-row-value" id="rpt-new-players">{{ report.registrations.count|default(0) }}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Flotten gesendet</span>
                <span class="report-row-value" id="rpt-fleets-sent">{% if report.fleets_sent.count is defined and report.fleets_sent.count >= 0 %}{{ report.fleets_sent.count }}{% else %}n/a{% endif %}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">K&auml;mpfe</span>
                <span class="report-row-value" id="rpt-combats">{% if report.combats.count is defined and report.combats.count >= 0 %}{{ report.combats.count }}{% else %}n/a{% endif %}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Nachrichten</span>
                <span class="report-row-value" id="rpt-messages">{% if report.messages.count is defined and report.messages.count >= 0 %}{{ report.messages.count }}{% else %}n/a{% endif %}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Neue Allianzen</span>
                <span class="report-row-value" id="rpt-alliances">{% if report.alliances_founded.count is defined and report.alliances_founded.count >= 0 %}{{ report.alliances_founded.count }}{% else %}n/a{% endif %}</span>
            </div>
        </div>

        <!-- Top Spieler -->
        <div class="report-card">
            <div class="report-card-title">Top 5 Spieler (Punkte)</div>
            <div id="top-players-list">
                {% if report.top_players is defined and report.top_players is not empty %}
                    {% for player in report.top_players %}
                    <div class="top-player-item">
                        <div class="top-player-rank{% if loop.index == 1 %} gold{% elseif loop.index == 2 %} silver{% elseif loop.index == 3 %} bronze{% endif %}">{{ loop.index }}</div>
                        <div class="top-player-name">{{ player.username|default('Unknown') }}</div>
                        <div class="top-player-points">{{ player.points|default(0)|number }} Pkt</div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="no-data">Keine Spielerdaten verf&uuml;gbar</div>
                {% endif %}
            </div>
        </div>

        <!-- Aktivste Spieler -->
        <div class="report-card">
            <div class="report-card-title">Aktivste Spieler</div>
            <div id="active-players-list">
                {% if report.active_players is defined and report.active_players is not empty %}
                    {% for player in report.active_players %}
                    <div class="top-player-item">
                        <div class="top-player-rank{% if loop.index == 1 %} gold{% elseif loop.index == 2 %} silver{% elseif loop.index == 3 %} bronze{% endif %}">{{ loop.index }}</div>
                        <div class="top-player-name">{{ player.username|default('Unknown') }}</div>
                        <div class="top-player-points">Letzte Aktivit&auml;t</div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="no-data">Keine Aktivit&auml;tsdaten verf&uuml;gbar</div>
                {% endif %}
            </div>
        </div>

        <!-- Auffaelligkeiten -->
        <div class="report-card">
            <div class="report-card-title">Auff&auml;lligkeiten</div>
            <div class="report-row">
                <span class="report-row-label">Geteilte IPs</span>
                <span class="report-row-value" id="rpt-multi-ips">{% if report.multiaccount_flags.flagged_ips is defined and report.multiaccount_flags.flagged_ips >= 0 %}{{ report.multiaccount_flags.flagged_ips }}{% else %}n/a{% endif %}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Betroffene Accounts</span>
                <span class="report-row-value" id="rpt-multi-users">{% if report.multiaccount_flags.flagged_users is defined and report.multiaccount_flags.flagged_users >= 0 %}{{ report.multiaccount_flags.flagged_users }}{% else %}n/a{% endif %}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Gesperrte Spieler</span>
                <span class="report-row-value">{{ report.banned_players.count|default(0) }}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Offene Tickets</span>
                <span class="report-row-value">{% if report.open_tickets.count is defined and report.open_tickets.count >= 0 %}{{ report.open_tickets.count }}{% else %}n/a{% endif %}</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Hardware Fingerprints</span>
                <span class="report-row-value na">n/a (nicht verf&uuml;gbar)</span>
            </div>
            <div class="report-row">
                <span class="report-row-label">Ressourcen bewegt</span>
                <span class="report-row-value na">n/a (nicht getrackt)</span>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js CDN (lightweight, only loaded in admin) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<script>
// Inline chart data from server
window.adminDashboardData = {
    charts: {{ chartData|json_encode|raw }},
    report: {{ report|json_encode|raw }}
};
</script>

{% include "overall_footer.twig" %}
