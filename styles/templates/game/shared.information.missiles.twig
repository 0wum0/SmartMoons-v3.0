<form action="game.php?page=information&amp;mode=destroyMissiles&amp;elementID={{ elementID }}" method="post">
<div class="aerospace-missile-card">
    <div class="missile-header">
        <i class="fas fa-bomb"></i> {{ LNG.in_missilesamount }}
    </div>

    <div class="missile-list">
        <div class="missile-row">
            <div class="m-icon"><img src="{{ dpath }}gebaeude/503.gif" alt=""></div>
            <div class="m-info">
                <span class="m-name">{{ LNG.tech.503 }}</span>
                <span class="m-count">{{ MissileList.503|number_format }}</span>
            </div>
            <div class="m-action">
                <input class="glass-input" type="number" name="missile[503]" placeholder="0" min="0" max="{{ MissileList.503 }}">
            </div>
        </div>

        <div class="missile-row">
            <div class="m-icon"><img src="{{ dpath }}gebaeude/502.gif" alt=""></div>
            <div class="m-info">
                <span class="m-name">{{ LNG.tech.502 }}</span>
                <span class="m-count">{{ MissileList.502|number_format }}</span>
            </div>
            <div class="m-action">
                <input class="glass-input" type="number" name="missile[502]" placeholder="0" min="0" max="{{ MissileList.502 }}">
            </div>
        </div>
    </div>

    <div class="missile-footer">
        <button type="submit" class="btn-destroy">
            <i class="fas fa-trash-alt"></i> {{ LNG.in_destroy }}
        </button>
    </div>
</div>
</form>

<style>
.aerospace-missile-card { padding: 20px; background: #0d111a; color: #ccc; font-family: 'Segoe UI', Tahoma, sans-serif; min-width: 300px; }
.missile-header { font-size: 1.2rem; color: #e74c3c; margin-bottom: 20px; text-align: center; text-transform: uppercase; font-weight: bold; border-bottom: 1px solid rgba(231, 76, 60, 0.3); padding-bottom: 10px; }

.missile-list { display: flex; flex-direction: column; gap: 15px; margin-bottom: 20px; }
.missile-row { display: flex; align-items: center; background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05); }

.m-icon img { width: 40px; height: 40px; border-radius: 4px; margin-right: 15px; }
.m-info { flex: 1; display: flex; flex-direction: column; }
.m-name { font-weight: bold; color: #fff; font-size: 0.9rem; }
.m-count { color: #00f3ff; font-family: monospace; font-size: 1.1rem; }

.glass-input { 
    background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); 
    color: #fff; padding: 8px; width: 80px; text-align: center; border-radius: 4px;
}
.glass-input:focus { border-color: #e74c3c; outline: none; }

.missile-footer { text-align: center; }
.btn-destroy {
    background: rgba(231, 76, 60, 0.2); border: 1px solid #e74c3c; color: #e74c3c;
    padding: 10px 30px; border-radius: 4px; cursor: pointer; font-weight: bold; transition: 0.2s;
}
.btn-destroy:hover { background: #e74c3c; color: #fff; box-shadow: 0 0 15px rgba(231, 76, 60, 0.4); }
</style>