<div class="aerospace-gate-modal">
    <div class="gate-header">{{ LNG.in_jump_gate_select_ships }}</div>
    
    <div class="gate-content">
        {% if gateData.restTime != 0 %}
            <div class="gate-wait">
                <i class="fas fa-hourglass-half"></i>
                <p>{{ LNG.in_jump_gate_wait_time }}</p>
                <div class="countdown" data-time="{{ gateData.restTime }}">{{ pretty_fly_time(gateData.restTime) }}</div>
                <div class="next-jump">{{ gateData.nextTime }}</div>
            </div>
        {% else %}
            <div class="gate-route">
                <div class="route-node">
                    <span class="label">{{ LNG.in_jump_gate_start_moon }}</span>
                    <span class="val">{{ gateData.startLink }}</span>
                </div>
                <div class="route-arrow"><i class="fas fa-chevron-right"></i></div>
                <div class="route-node">
                    <span class="label">{{ LNG.in_jump_gate_finish_moon }}</span>
                    <div class="target-select">
                        <select name="target_moon" class="glass-select">
                            {% for moonID, moonName in gateData.gateList %}
                                <option value="{{ moonID }}">{{ moonName }}</option>
                            {% endfor %}
                         </select>
                    </div>
                </div>
            </div>

            {% if gateData.gateList %}
                <div class="ship-list custom-scroll">
                    {% for fleetID, amount in gateData.fleetList %}
                    <div class="ship-row">
                        <div class="ship-name">{{ LNG.tech[fleetID] }}</div>
                        <div class="ship-avail" id="ship{{ fleetID }}_value">{{ amount|number_format(0, '.', ',') }}</div>
                        <div class="ship-input">
                            <input class="glass-input" name="ship[{{ fleetID }}]" id="ship{{ fleetID }}_input" value="0" type="text">
                            <button onclick="Gate.max({{ fleetID }});" class="btn-max">MAX</button>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="gate-actions">
                    <button class="btn-jump" onclick="Gate.submit();">{{ LNG.in_jump_gate_jump }}</button>
                </div>
            {% else %}
                <div class="gate-error">{{ LNG.in_jump_gate_no_target }}</div>
            {% endif %}
        {% endif %}
    </div>
</div>

<style>
.aerospace-gate-modal {
    background: #0d111a; color: #ccc; font-family: 'Segoe UI', Tahoma, sans-serif;
    padding: 15px;
}
.gate-header {
    font-size: 1.2rem; color: #00f3ff; border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 10px; margin-bottom: 15px; font-weight: bold; text-align: center;
}

.gate-wait { text-align: center; padding: 30px; color: #e74c3c; }
.gate-wait i { font-size: 3rem; margin-bottom: 15px; }
.countdown { font-size: 1.5rem; font-weight: bold; color: #fff; margin: 10px 0; }

.gate-route { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; background: rgba(255,255,255,0.03); padding: 15px; border-radius: 6px; }
.route-node { display: flex; flex-direction: column; gap: 5px; }
.route-node .label { font-size: 0.8rem; color: #888; text-transform: uppercase; }
.route-node .val { color: #fff; font-weight: bold; }
.route-arrow { color: #00f3ff; font-size: 1.2rem; }

.ship-list { max-height: 300px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; margin-bottom: 15px; }
.ship-row { display: flex; align-items: center; padding: 8px 10px; border-bottom: 1px solid rgba(255,255,255,0.05); }
.ship-row:last-child { border-bottom: none; }
.ship-name { flex: 1; color: #ddd; }
.ship-avail { width: 80px; text-align: right; margin-right: 15px; font-family: monospace; color: #aaa; }
.ship-input { display: flex; gap: 5px; }

.glass-input { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 4px; width: 60px; text-align: right; border-radius: 3px; }
.btn-max { background: rgba(0, 243, 255, 0.2); border: 1px solid #00f3ff; color: #00f3ff; cursor: pointer; border-radius: 3px; font-size: 0.7rem; }
.glass-select { background: #000; color: #fff; border: 1px solid #555; padding: 5px; }

.gate-actions { text-align: center; }
.btn-jump { background: linear-gradient(45deg, #00f3ff, #0072ff); border: none; padding: 10px 30px; border-radius: 4px; font-weight: bold; color: #000; cursor: pointer; }
.gate-error { color: #e74c3c; text-align: center; padding: 20px; font-weight: bold; }
</style>