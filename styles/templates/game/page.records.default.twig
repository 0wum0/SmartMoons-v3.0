{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_records }}{% endblock %}
{% block content %}

<div class="content_page">
    <div class="aerospace-wrapper">
        
        <div class="glass-panel header-panel">
            <h2 class="page-title"><i class="fas fa-trophy"></i> {{ LNG.lm_records }}</h2>
            <span class="update-info">{{ LNG.rec_last_update_on }}: {{ update }}</span>
        </div>

        <div class="records-grid">
            
            <div class="record-column">
                <div class="col-head build"><i class="fas fa-home"></i> {{ LNG.tech.0 }}</div>
                <div class="record-list custom-scroll">
                    {% for elementID, elementRow in buildList %}
                    <div class="rec-item">
                        <div class="rec-left">
                            <div class="rec-tech">{{ LNG.tech[elementID] }}</div>
                            <div class="rec-users">
                                {% if elementRow %}
                                    {% for user in elementRow %}
                                        <a href='#' onclick='return Dialog.Playercard({{ user.userID }});'>{{ user.username }}</a>{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% else %}-{% endif %}
                            </div>
                        </div>
                        <div class="rec-right">
                            {% if elementRow %}<span class="rec-val">{{ elementRow[0].level|number_format }}</span>{% else %}-{% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="record-column">
                <div class="col-head tech"><i class="fas fa-flask"></i> {{ LNG.tech.100 }}</div>
                <div class="record-list custom-scroll">
                    {% for elementID, elementRow in researchList %}
                    <div class="rec-item">
                        <div class="rec-left">
                            <div class="rec-tech">{{ LNG.tech[elementID] }}</div>
                            <div class="rec-users">
                                {% if elementRow %}
                                    {% for user in elementRow %}
                                        <a href='#' onclick='return Dialog.Playercard({{ user.userID }});'>{{ user.username }}</a>{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% else %}-{% endif %}
                            </div>
                        </div>
                        <div class="rec-right">
                            {% if elementRow %}<span class="rec-val">{{ elementRow[0].level|number_format }}</span>{% else %}-{% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="record-column">
                <div class="col-head fleet"><i class="fas fa-fighter-jet"></i> {{ LNG.tech.200 }}</div>
                <div class="record-list custom-scroll">
                    {% for elementID, elementRow in fleetList %}
                    <div class="rec-item">
                        <div class="rec-left">
                            <div class="rec-tech">{{ LNG.tech[elementID] }}</div>
                            <div class="rec-users">
                                {% if elementRow %}
                                    {% for user in elementRow %}
                                        <a href='#' onclick='return Dialog.Playercard({{ user.userID }});'>{{ user.username }}</a>{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% else %}-{% endif %}
                            </div>
                        </div>
                        <div class="rec-right">
                            {% if elementRow %}<span class="rec-val">{{ elementRow[0].level|number_format }}</span>{% else %}-{% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="record-column">
                <div class="col-head def"><i class="fas fa-shield-alt"></i> {{ LNG.tech.400 }}</div>
                <div class="record-list custom-scroll">
                    {% for elementID, elementRow in defenseList %}
                    <div class="rec-item">
                        <div class="rec-left">
                            <div class="rec-tech">{{ LNG.tech[elementID] }}</div>
                            <div class="rec-users">
                                {% if elementRow %}
                                    {% for user in elementRow %}
                                        <a href='#' onclick='return Dialog.Playercard({{ user.userID }});'>{{ user.username }}</a>{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% else %}-{% endif %}
                            </div>
                        </div>
                        <div class="rec-right">
                            {% if elementRow %}<span class="rec-val">{{ elementRow[0].level|number_format }}</span>{% else %}-{% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</div>

<style>
/* RECORDS STYLES */
.aerospace-wrapper { width: 100%; padding: 15px; box-sizing: border-box; }
.header-panel { display: flex; justify-content: space-between; align-items: center; padding: 15px 25px; margin-bottom: 20px; background: rgba(16, 20, 28, 0.8); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 8px; }
.update-info { color: #888; font-size: 0.9rem; }

.records-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
.record-column { background: rgba(22, 27, 38, 0.9); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; display: flex; flex-direction: column; height: 600px; }

.col-head { padding: 15px; font-weight: bold; text-transform: uppercase; font-size: 1.1rem; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; }
.col-head.build { color: #f1c40f; border-top: 3px solid #f1c40f; }
.col-head.tech { color: #3498db; border-top: 3px solid #3498db; }
.col-head.fleet { color: #e74c3c; border-top: 3px solid #e74c3c; }
.col-head.def { color: #2ecc71; border-top: 3px solid #2ecc71; }

.record-list { flex: 1; overflow-y: auto; padding: 0; }

.rec-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 15px; border-bottom: 1px solid rgba(255,255,255,0.02);
    transition: 0.2s;
}
.rec-item:hover { background: rgba(255,255,255,0.02); }
.rec-left { flex: 1; }
.rec-tech { color: #ccc; font-weight: bold; margin-bottom: 2px; }
.rec-users { font-size: 0.8rem; }
.rec-users a { color: #00f3ff; text-decoration: none; }
.rec-val { font-weight: bold; color: #fff; font-family: monospace; font-size: 1.1rem; background: rgba(0,0,0,0.3); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1); }
</style>
{% endblock %}