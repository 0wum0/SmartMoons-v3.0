{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_options }}{% endblock %}
{% block content %}
<form action="game.php?page=settings&amp;mode=send" method="post">

<div class="content_page">
    <div class="aerospace-wrapper" style="display: flex; justify-content: center;">
        
        <div class="glass-panel vacation-card">
            <div class="vac-header">
                <i class="fas fa-umbrella-beach"></i>
                <h2>{{ LNG.op_vacation_mode_active_message }}</h2>
            </div>
            
            <div class="vac-date">{{ vacationUntil }}</div>
            
            <div class="vac-actions">
                <div class="vac-row">
                    <label>{{ LNG.op_end_vacation_mode }}</label>
                    <input name="vacation" type="checkbox" value="1" {% if canVacationDisbaled %}disabled{% endif %}>
                </div>
                
                <div class="vac-row danger">
                    <label>{{ LNG.op_dlte_account }}</label>
                    <input name="delete" type="checkbox" value="1" {% if delete > 0 %}checked="checked"{% endif %}>
                </div>
            </div>

            <button type="submit" class="btn-save-vac">{{ LNG.op_save_changes }}</button>
        </div>

    </div>
</div>
</form>

<style>
.vacation-card { 
    background: rgba(16, 20, 28, 0.9); padding: 40px; 
    border: 1px solid rgba(0, 243, 255, 0.3); border-radius: 12px;
    text-align: center; width: 100%; max-width: 500px; margin-top: 50px;
}
.vac-header { color: #00f3ff; font-size: 1.2rem; margin-bottom: 10px; }
.vac-header i { font-size: 3rem; margin-bottom: 15px; display: block; }
.vac-date { font-size: 1.5rem; color: #fff; margin-bottom: 30px; font-weight: bold; }
.vac-row { display: flex; justify-content: space-between; padding: 15px; background: rgba(255,255,255,0.05); margin-bottom: 10px; border-radius: 6px; }
.vac-row.danger { border: 1px solid rgba(231, 76, 60, 0.3); }
.btn-save-vac { background: #00f3ff; border: none; padding: 10px 30px; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 20px; }
</style>
{% endblock %}