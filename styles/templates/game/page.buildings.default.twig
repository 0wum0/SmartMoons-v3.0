{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_buildings }}{% endblock %}

{% block content %}
<div class="aerospace-container">
    
    <div class="glass-panel header-panel">
        <div class="header-content">
            <h2 class="page-title"><i class="fas fa-city"></i> {{ LNG.lm_buildings }}</h2>
            <div class="planet-fields">
                <span class="field-label">{{ LNG.bd_remaining }}</span>
                <div class="field-bar-wrapper">
                    {% set field_percent = (field_max > 0) ? (field_current / field_max * 100) : 100 %}
                    <div class="field-bar" style="width: {{ (field_percent > 100) ? 100 : field_percent }}%"></div>
                </div>
                <span class="field-val {% if field_current >= field_max %}text-danger{% endif %}">
                    {{ field_current }} / {{ field_max }}
                </span>
            </div>
        </div>
    </div>

    {% if Queue %}
    <div class="glass-panel queue-panel">
        <div class="panel-header">
            <i class="fas fa-tasks"></i> {{ LNG.bd_building_queue }} 
            <span class="queue-badge">{{ Queue|length }}</span>
        </div>
        
        <div class="queue-list-wrapper">
            {% for List in Queue %}
            <div class="queue-item {% if loop.first %}active-build{% endif %}">
                
                <div class="queue-visual">
                    <span class="queue-pos">{{ loop.index }}</span>
                    <img src="{{ dpath }}gebaeude/{{ List.element }}.gif" alt="{{ LNG.tech[List.element] }}" class="queue-img">
                </div>

                <div class="queue-details">
                    <div class="queue-title">
                        {{ LNG.tech[List.element] }} 
                        <span class="lvl-badge">{{ List.level }}</span>
                    </div>
                    
                    {% if loop.first %}
                        <div class="active-timer-box">
                            <span class="timer" data-time="{{ List.endtime }}">{{ List.display }}</span>
                        </div>
                        <div class="queue-progress-track">
                             <div class="queue-progress-bar" style="width: 100%;"></div> 
                        </div>
                    {% else %}
                        <div class="waiting-timer">
                            <i class="fas fa-clock"></i> <span class="timer" data-time="{{ List.endtime }}">{{ List.display }}</span>
                        </div>
                    {% endif %}
                </div>

                <div class="queue-action">
                    <form action="game.php?page=buildings" method="post">
                        <input type="hidden" name="cmd" value="{% if loop.first %}cancel{% else %}remove{% endif %}">
                        {% if not loop.first %}<input type="hidden" name="listid" value="{{ loop.index }}">{% endif %}
                        <button type="submit" class="btn-icon-danger" title="{{ LNG.bd_cancel }}">
                            <i class="fas fa-times"></i>
                        </button>
                    </form>
                </div>

            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="tech-grid">
        {% for ID, Element in BuildInfoList %}
        <div class="glass-panel tech-card {% if not Element.buyable %}disabled{% endif %}">
            
            <div class="tech-visual">
                <img src="{{ dpath }}gebaeude/{{ ID }}.gif" alt="{{ LNG.tech[ID] }}" class="tech-img">
                {% if Element.level > 0 %}
                <span class="level-tag">{{ Element.level }}</span>
                {% endif %}
            </div>

            <div class="tech-content">
                <div class="tech-header">
                    <h3 class="tech-name">
                        <a href="#" onclick="return Dialog.info({{ ID }});">{{ LNG.tech[ID] }}</a>
                    </h3>
                    {% if Element.maxLevel != 255 %}
                    <span class="max-lvl">{{ LNG.bd_max_level }}: {{ Element.maxLevel }}</span>
                    {% endif %}
                </div>

                <div class="tech-price">
                    {% for RessID, RessAmount in Element.costResources %}
                    <div class="price-item {% if Element.costOverflow[RessID] != 0 %}missing-res{% endif %}">
                        <img src="{{ dpath }}images/{{ RessID }}.gif" alt="" class="res-icon-sm">
                        <span class="res-val">{{ RessAmount|number_format }}</span>
                    </div>
                    {% endfor %}
                </div>
                
                <div class="tech-meta">
                    <span class="meta-item"><i class="far fa-clock"></i> {{ Element.elementTime|time }}</span>
                    
                    {% if Element.infoEnergy %}
                    <span class="meta-item energy">
                        <i class="fas fa-bolt"></i> {{ Element.infoEnergy|raw }}
                    </span>
                    {% endif %}
                </div>

                <div class="tech-actions">
                    {% if Element.maxLevel == Element.levelToBuild %}
                        <div class="btn-disabled"><i class="fas fa-check"></i> {{ LNG.bd_maxlevel }}</div>
                    {% elseif (isBusy.research and (ID == 6 or ID == 31)) or (isBusy.shipyard and (ID == 15 or ID == 21)) %}
                        <div class="btn-disabled"><i class="fas fa-cog fa-spin"></i> {{ LNG.bd_working }}</div>
                    {% elseif not RoomIsOk %}
                        <div class="btn-disabled text-danger"><i class="fas fa-ban"></i> {{ LNG.bd_no_more_fields }}</div>
                    {% elseif not CanBuildElement or not Element.buyable %}
                        <div class="btn-disabled text-danger"><i class="fas fa-lock"></i> {{ LNG.bd_notres }}</div>
                    {% else %}
                        <form action="game.php?page=buildings" method="post" class="full-width-form">
                            <input type="hidden" name="cmd" value="insert">
                            <input type="hidden" name="building" value="{{ ID }}">
                            <button type="submit" class="btn-action-glow">
                                {% if Element.level == 0 %}
                                    {{ LNG.bd_build }}
                                {% else %}
                                    {{ LNG.bd_build_next_level }} {{ Element.levelToBuild + 1 }}
                                {% endif %}
                            </button>
                        </form>
                    {% endif %}
                </div>
                
                {% if Element.level > 0 %}
                <div class="tech-extras">
                    {% if ID == 43 %}
                        <a href="#" onclick="return Dialog.info({{ ID }})" class="extra-link">{{ LNG.bd_jump_gate_action }}</a>
                    {% endif %}
                    
                    {% if (ID == 44 and not HaveMissiles) or ID != 44 %}
                    <a class="demolish-link" onclick="confirmDemolish('{{ ID }}', '{{ LNG.tech[ID] }}', '{{ Element.destroyTime|time }}');">
                       <i class="fas fa-trash-alt"></i>
                    </a>
                    {% endif %}
                </div>
                {% endif %}

            </div>
        </div>
        {% endfor %}
    </div>

</div>

<style>
.aerospace-container { padding: 0 1rem; }
.header-panel { display: flex; align-items: center; justify-content: space-between; padding: 1.5rem; }
.page-title { margin: 0; font-family: var(--font-heading); color: var(--primary); font-size: 1.8rem; }

.planet-fields { display: flex; align-items: center; gap: 15px; background: rgba(0,0,0,0.3); padding: 8px 15px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.05); }
.field-bar-wrapper { width: 100px; height: 6px; background: #000; border-radius: 3px; overflow: hidden; }
.field-bar { height: 100%; background: var(--success); box-shadow: 0 0 5px var(--success); }
.field-val { font-family: monospace; font-size: 0.9rem; color: #fff; }

/* Queue */
.queue-panel { padding: 0; overflow: hidden; }
.panel-header { background: rgba(0,0,0,0.2); padding: 1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); font-family: var(--font-heading); display: flex; align-items: center; gap: 10px; }
.queue-badge { background: var(--primary); color: #000; padding: 2px 8px; border-radius: 10px; font-size: 0.8rem; font-weight: bold; }

.queue-list-wrapper { padding: 1rem; }
.queue-item { display: flex; align-items: center; background: rgba(255,255,255,0.02); margin-bottom: 8px; border-radius: 8px; padding: 10px; border: 1px solid transparent; }
.queue-item.active-build { border-color: var(--primary); background: rgba(0, 243, 255, 0.05); }

.queue-visual { position: relative; width: 50px; height: 50px; margin-right: 15px; }
.queue-img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
.queue-pos { position: absolute; top: -5px; left: -5px; background: #000; border: 1px solid var(--text-muted); width: 20px; height: 20px; display: flex; justify-content: center; align-items: center; font-size: 0.7rem; border-radius: 50%; }

.queue-details { flex: 1; }
.queue-title { font-weight: bold; color: #fff; margin-bottom: 4px; }
.lvl-badge { color: var(--primary); font-size: 0.8rem; }
.timer { font-family: monospace; color: var(--text-muted); }

.btn-icon-danger { background: none; border: none; color: var(--danger); cursor: pointer; font-size: 1.1rem; transition: 0.2s; }
.btn-icon-danger:hover { text-shadow: 0 0 10px var(--danger); transform: scale(1.1); }

/* Tech Grid */
.tech-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
.tech-card { padding: 0; display: flex; flex-direction: column; transition: transform 0.3s; }
.tech-card:hover { transform: translateY(-5px); border-color: var(--primary); }
.tech-card.disabled { opacity: 0.7; filter: grayscale(0.8); }
.tech-card.disabled:hover { filter: grayscale(0); opacity: 1; }

.tech-visual { height: 120px; position: relative; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,0.05); }
.tech-img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; }
.tech-card:hover .tech-img { transform: scale(1.1); }
.level-tag { position: absolute; bottom: 10px; right: 10px; background: var(--primary); color: #000; font-weight: bold; padding: 2px 8px; border-radius: 4px; box-shadow: 0 0 10px rgba(0,243,255,0.5); }

.tech-content { padding: 1.2rem; display: flex; flex-direction: column; flex: 1; }
.tech-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; }
.tech-name a { color: #fff; font-family: var(--font-heading); font-size: 1.1rem; text-decoration: none; }
.tech-name a:hover { color: var(--primary); }
.max-lvl { font-size: 0.7rem; color: var(--text-muted); }

.tech-price { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 1rem; }
.price-item { display: flex; align-items: center; gap: 5px; background: rgba(0,0,0,0.3); padding: 4px 8px; border-radius: 4px; font-size: 0.85rem; color: #ccc; border: 1px solid transparent; }
.price-item.missing-res { border-color: var(--danger); color: var(--danger); }
.res-icon-sm { width: 16px; height: 16px; }

.tech-meta { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem; }
.tech-meta .energy { color: var(--warning); }

.tech-actions { margin-top: auto; }
.full-width-form { width: 100%; }
.btn-action-glow { width: 100%; background: linear-gradient(90deg, rgba(0,243,255,0.1), rgba(0,243,255,0.2)); border: 1px solid var(--primary); color: var(--primary); padding: 10px; border-radius: 6px; font-family: var(--font-heading); cursor: pointer; transition: 0.3s; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; }
.btn-action-glow:hover { background: var(--primary); color: #000; box-shadow: 0 0 15px rgba(0,243,255,0.6); }

.btn-disabled { width: 100%; text-align: center; padding: 10px; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: var(--text-muted); font-size: 0.85rem; cursor: not-allowed; background: rgba(0,0,0,0.2); }
.text-danger { color: var(--danger) !important; border-color: var(--danger); }

.tech-extras { display: flex; justify-content: space-between; margin-top: 10px; font-size: 0.8rem; align-items: center; }
.extra-link { color: var(--secondary); text-decoration: underline; }
.demolish-link { color: var(--text-muted); cursor: pointer; padding: 5px; }
.demolish-link:hover { color: var(--danger); }
</style>

<script>
function confirmDemolish(id, name, time) {
    if(confirm("{{ LNG.bd_dismantle }} " + name + "?\n{{ LNG.bd_duration }}: " + time)) {
        var form = document.createElement('form');
        form.method = 'post';
        form.action = 'game.php?page=buildings';
        
        var inputCmd = document.createElement('input');
        inputCmd.type = 'hidden';
        inputCmd.name = 'cmd';
        inputCmd.value = 'destroy';
        
        var inputId = document.createElement('input');
        inputId.type = 'hidden';
        inputId.name = 'building';
        inputId.value = id;

        form.appendChild(inputCmd);
        form.appendChild(inputId);
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}