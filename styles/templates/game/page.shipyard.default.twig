{% extends "layout.full.twig" %}

{% block title %}{% if mode == "defense" %}{{ LNG.lm_defenses }}{% else %}{{ LNG.lm_shipshard }}{% endif %}{% endblock %}
{% block content %}

<div class="content_page">
    <div class="aerospace-wrapper">
        
        <div class="glass-panel header-panel">
            <h2 class="page-title">
                {% if mode == "defense" %}
                    <i class="fas fa-shield-alt"></i> {{ LNG.lm_defenses }}
                {% else %}
                    <i class="fas fa-fighter-jet"></i> {{ LNG.lm_shipshard }}
                {% endif %}
            </h2>
        </div>

        {% if BuildList %}
        <div class="glass-panel queue-panel">
            <div class="queue-header">
                <span><i class="fas fa-tasks"></i> {{ LNG.bd_production_queue }}</span>
                <span id="timeleft"></span>
            </div>
            <div class="queue-body">
                <select name="auftr[]" id="auftr" size="5" multiple class="queue-list">
                    <option>&nbsp;</option>
                </select>
                <form action="game.php?page=shipyard&amp;mode={{ mode }}" method="post" class="cancel-form">
                    <input type="hidden" name="action" value="delete">
                    <button type="submit" class="btn-cancel">{{ LNG.bd_cancel_send }}</button>
                </form>
            </div>
        </div>
        {% endif %}

        {% if not NotBuilding %}
        <div class="status-alert">
            {{ LNG.bd_building_shipyard }}
        </div>
        {% endif %}

        <form action="game.php?page=shipyard&amp;mode={{ mode }}" method="post">
            
            <div class="ship-grid-container">
                {% for ID, Element in elementList %}
                <div class="ship-card-item">
                    
                    <div class="ship-img-box" onclick="return Dialog.info({{ ID }})">
                        <img src="{{ dpath }}gebaeude/{{ ID }}.gif" alt="{{ LNG.tech[ID] }}">
                        <span class="count-tag">{{ Element.available|number_format }}</span>
                    </div>

                    <div class="ship-details">
                        <div class="s-title" onclick="return Dialog.info({{ ID }})">{{ LNG.tech[ID] }}</div>
                        <div class="s-time"><i class="far fa-clock"></i> {{ Element.elementTime|time }}</div>
                        
                        <div class="s-costs">
                            {% for RessID, RessAmount in Element.costResources %}
                            <div class="cost-badge {% if Element.costOverflow[RessID] == 0 %}green{% else %}red{% endif %}">
                                <img src="{{ dpath }}images/{{ RessID }}.gif" width="12" height="12">
                                {{ RessAmount|shortly_number }}
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="ship-actions">
                        {% if Element.AlreadyBuild %}
                            <div class="msg-box green">{{ LNG.bd_protection_shield_only_one }}</div>
                        {% elseif NotBuilding and Element.buyable %}
                            <div class="input-row">
                                <input type="number" name="fmenge[{{ ID }}]" id="input_{{ ID }}" value="0" min="0" max="{{ Element.maxBuildable }}" tabindex="{{ loop.index }}" placeholder="0">
                                {% if Element.maxBuildable %}
                                <button type="button" class="btn-max" onclick="$('#input_{{ ID }}').val('{{ Element.maxBuildable }}')">MAX</button>
                                {% endif %}
                            </div>
                            {% if Element.maxBuildable %}
                            <div class="max-txt" onclick="$('#input_{{ ID }}').val('{{ Element.maxBuildable }}')">Max: {{ Element.maxBuildable|number_format }}</div>
                            {% endif %}
                        {% else %}
                            <div class="msg-box red">{{ LNG.bd_not_possible }}</div>
                        {% endif %}
                    </div>

                </div>
                {% endfor %}
            </div>

            {% if NotBuilding %}
            <div class="dock-footer">
                <button type="submit" class="btn-build-final">{{ LNG.bd_build_ships }}</button>
            </div>
            {% endif %}

        </form>

    </div>
</div>

{% endblock %}
{% block script %}
<script type="text/javascript">
data = {{ BuildList|json_encode|raw }};
bd_operating = '{{ LNG.bd_operating }}';
bd_available = '{{ LNG.bd_available }}';

$(function() {
    if(typeof ShipyardInit === 'function') {
        ShipyardInit();
    }
});
</script>
{% endblock %}

{% block style %}
<style>
/* Reset */
.aerospace-wrapper { width: 100%; padding: 15px; box-sizing: border-box; padding-bottom: 100px; }

/* Header */
.header-panel { padding: 15px; background: rgba(16, 20, 28, 0.9); border: 1px solid rgba(0, 243, 255, 0.3); border-radius: 8px; text-align: center; margin-bottom: 20px; }
.page-title { margin: 0; color: #fff; font-size: 1.4rem; text-transform: uppercase; }

/* Queue */
.queue-panel { margin-bottom: 20px; background: #111; padding: 10px; border: 1px solid #333; border-radius: 5px; }
.queue-header { display: flex; justify-content: space-between; color: #00f3ff; margin-bottom: 10px; font-weight: bold; }
.queue-body { display: flex; gap: 10px; }
.queue-list { flex: 1; background: #000; border: 1px solid #444; color: #ccc; padding: 5px; height: 60px; }
.btn-cancel { background: #e74c3c; border: none; color: #fff; padding: 0 15px; cursor: pointer; font-weight: bold; border-radius: 3px; }

.status-alert { background: rgba(241, 196, 15, 0.2); color: #f1c40f; padding: 10px; text-align: center; margin-bottom: 15px; border: 1px solid #f1c40f; }

/* --- GRID SYSTEM (Fest definiert) --- */
.ship-grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); /* Karten sind mind. 220px breit */
    gap: 15px;
}

/* --- KARTE --- */
.ship-card-item {
    background: #151921;
    border: 1px solid #2c3e50;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: 0.2s;
}
.ship-card-item:hover {
    border-color: #00f3ff;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.5);
}

/* 1. Bild */
.ship-img-box {
    position: relative;
    width: 100%;
    height: 120px !important; /* WICHTIG: Erzwingt Höhe */
    background: #000;
    overflow: hidden;
    border-bottom: 1px solid #2c3e50;
    cursor: pointer;
}
.ship-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* WICHTIG: Bild passt sich ein, verzerrt nicht */
    opacity: 0.8;
    transition: 0.3s;
}
.ship-card-item:hover .ship-img-box img { opacity: 1; transform: scale(1.05); }

.count-tag {
    position: absolute; bottom: 5px; right: 5px;
    background: rgba(0,0,0,0.8); color: #00f3ff;
    padding: 2px 6px; font-size: 0.8rem; border-radius: 3px; border: 1px solid #00f3ff;
    font-weight: bold;
}

/* 2. Details */
.ship-details { padding: 10px; text-align: center; flex: 1; }
.s-title { font-weight: bold; color: #fff; font-size: 0.95rem; margin-bottom: 5px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.s-time { font-size: 0.8rem; color: #888; margin-bottom: 8px; }

.s-costs { display: flex; flex-wrap: wrap; gap: 4px; justify-content: center; }
.cost-badge {
    display: flex; align-items: center; gap: 3px;
    background: #222; padding: 2px 5px; border-radius: 3px;
    font-size: 0.75rem; color: #ccc; border: 1px solid #333;
}
.cost-badge.red { border-color: #e74c3c; color: #e74c3c; }

/* 3. Action / Input */
.ship-actions { padding: 10px; background: #0e1116; border-top: 1px solid #2c3e50; margin-top: auto; }

.input-row { display: flex; width: 100%; }
.input-row input {
    flex: 1; 
    background: #222; border: 1px solid #444; color: #fff;
    padding: 6px; text-align: center; font-weight: bold;
    border-radius: 3px 0 0 3px;
    width: 50px; /* Backup für kleine Screens */
}
.input-row input:focus { outline: none; border-color: #00f3ff; }

.btn-max {
    background: #00f3ff; color: #000; font-weight: bold; border: none;
    padding: 0 10px; cursor: pointer; border-radius: 0 3px 3px 0;
    font-size: 0.8rem;
}
.btn-max:hover { background: #fff; }

.max-txt { text-align: center; font-size: 0.75rem; color: #666; margin-top: 4px; cursor: pointer; }
.msg-box { font-size: 0.8rem; text-align: center; font-style: italic; }
.msg-box.red { color: #e74c3c; }
.msg-box.green { color: #2ecc71; }

/* Footer */
.dock-footer {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: rgba(16, 20, 28, 0.95);
    border-top: 1px solid #00f3ff;
    padding: 15px; text-align: center;
    z-index: 999;
}
.btn-build-final {
    background: #00f3ff; color: #000; border: none;
    padding: 12px 40px; font-weight: bold; font-size: 1.1rem;
    border-radius: 30px; cursor: pointer; box-shadow: 0 0 15px rgba(0,243,255,0.4);
    text-transform: uppercase;
}
.btn-build-final:hover { background: #fff; box-shadow: 0 0 25px rgba(0,243,255,0.8); }
</style>
{% endblock %}