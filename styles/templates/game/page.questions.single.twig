{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_faq }}{% endblock %}
{% block content %}

<div class="content_page">
    <div class="aerospace-wrapper">
        
        <div class="faq-detail-card glass-panel">
            <div class="detail-header">
                <h2><i class="far fa-question-circle"></i> {{ questionRow.title }}</h2>
                <a href="game.php?page=questions" class="btn-back">
                    <i class="fas fa-arrow-left"></i> {{ LNG.al_back }}
                </a>
            </div>
            
            <div class="detail-body custom-scroll">
                {{ questionRow.body|raw }}
            </div>
        </div>

    </div>
</div>

<style>
/* FAQ DETAIL STYLES */
.aerospace-wrapper { width: 100%; padding: 15px; box-sizing: border-box; }

.faq-detail-card {
    background: rgba(16, 20, 28, 0.95);
    border: 1px solid rgba(0, 243, 255, 0.2);
    border-radius: 8px;
    padding: 30px;
    min-height: 400px;
}

.detail-header {
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 20px; margin-bottom: 20px;
}

.detail-header h2 { margin: 0; color: #00f3ff; font-size: 1.6rem; }

.btn-back {
    background: rgba(255,255,255,0.05); color: #fff;
    padding: 8px 20px; border-radius: 4px; text-decoration: none;
    transition: 0.3s; border: 1px solid rgba(255,255,255,0.1);
}
.btn-back:hover { background: #00f3ff; color: #000; border-color: #00f3ff; }

.detail-body {
    line-height: 1.6; color: #ddd; font-size: 1rem;
}
</style>
{% endblock %}