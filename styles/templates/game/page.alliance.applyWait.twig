{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_alliance }}{% endblock %}
{% block content %}

<div class="aerospace-container">
    <div class="glass-panel center-panel text-center">
        
        <div class="panel-header">
            <i class="fas fa-hourglass-half fa-spin-pulse"></i> {{ LNG.al_your_request_title }}
        </div>

        <div class="wait-content">
            <p class="info-text">{{ request_text }}</p>
            
            <div class="status-box">
                <span class="status-label">{{ LNG.al_request_date }}:</span>
                <span class="status-value text-highlight">{{ "now"|date("d.m.Y") }}</span> <br>
                <span class="badge-pending">{{ LNG.al_waiting }}</span>
            </div>

            <form action="game.php?page=alliance&amp;mode=cancelApply" method="post" class="mt-4">
                <button type="submit" class="btn-icon-danger">
                    <i class="fas fa-times-circle"></i> {{ LNG.al_continue }} ({{ LNG.al_apply_cancel }})
                </button>
            </form>
        </div>

    </div>
</div>

<style>
.center-panel { max-width: 600px; margin: 50px auto; padding: 2rem; }
.fa-spin-pulse { animation-duration: 3s; color: var(--warning); }
.wait-content { padding: 1rem; }
.info-text { font-size: 1.1rem; color: #fff; margin-bottom: 2rem; }
.status-box { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; display: inline-block; min-width: 200px; }
.badge-pending { display: inline-block; margin-top: 10px; background: var(--warning); color: #000; padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 0.8rem; }
.mt-4 { margin-top: 2rem; }
</style>
{% endblock %}