{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_overview }}{% endblock %}

{% block content %}
<div class="dashboard-grid">
    
    <div class="dashboard-col-left">
        <div class="glass-panel planet-card">
            <div class="planet-visual">
                <img src="{{ dpath }}planeten/{{ planetimage }}.jpg" alt="{{ planetname }}" class="planet-img">
                <div class="planet-ring-glow"></div>
            </div>
            
            <h2 class="planet-title">
                {{ planetname }} 
                <a href="game.php?page=settings&mode=namer" class="rename-icon"><i class="fas fa-pen"></i></a>
            </h2>
            
            <div class="planet-stats">
                <div class="stat-row">
                    <span class="stat-label"><i class="fas fa-arrows-alt-h"></i> {{ LNG.ov_diameter }}</span>
                    <span class="stat-value">{{ planet_diameter }} km ({{ planet_field_current }}/{{ planet_field_max }})</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label"><i class="fas fa-thermometer-half"></i> {{ LNG.ov_temperature }}</span>
                    <span class="stat-value">{{ planet_temp_min }}°C / {{ planet_temp_max }}°C</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label"><i class="fas fa-map-marker-alt"></i> {{ LNG.ov_position }}</span>
                    <span class="stat-value"><a href="game.php?page=galaxy&galaxy={{ galaxy }}&system={{ system }}">{{ galaxy }}:{{ system }}:{{ planet }}</a></span>
                </div>
                <div class="stat-row">
                    <span class="stat-label"><i class="fas fa-chart-line"></i> {{ LNG.ov_points }}</span>
                    <span class="stat-value">{{ user_points }} (Rank {{ user_rank }})</span>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-col-center">
        
        {% if fleets|length > 0 %}
        <div class="glass-panel ops-panel">
            <div class="panel-header"><i class="fas fa-space-shuttle"></i> {{ LNG.ov_events }}</div>
            <div class="fleet-list scroll-area">
                {% for fleet in fleets %}
                <div class="fleet-event" data-fleet-end-time="{{ fleet.returntime }}" data-fleet-time="{{ fleet.resttime }}">
                    <div class="fleet-info">
                        <span class="mission-name {{ fleet.mission_class }}">{{ fleet.mission }}</span>
                        <span class="fleet-timer" id="fleettime_{{ loop.index }}">-</span>
                    </div>
                    <div class="progress-track">
                        <div class="progress-bar bar-fleet" style="width: 0%;" data-total="{{ fleet.totaltime }}" data-current="{{ fleet.resttime }}"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="glass-panel ops-panel">
            <div class="panel-header"><i class="fas fa-hammer"></i> {{ LNG.ov_building_queue }}</div>
            
            {% if buildInfo.buildings %}
            <div class="queue-item active-build">
                <div class="queue-info">
                    <span class="build-name">{{ buildInfo.buildings.name }} ({{ buildInfo.buildings.level }})</span>
                    <span class="build-timer" id="blc_vector" data-time="{{ buildInfo.buildings.timeleft }}">-</span>
                </div>
                <div class="progress-track">
                    <div class="progress-bar bar-build" id="blc_progressbar" data-time="{{ buildInfo.buildings.timeleft }}" data-total="{{ buildInfo.buildings.starttime }}"></div>
                </div>
            </div>
             {% if buildInfo.buildings.queue|length > 0 %}
                <div class="queue-upcoming">
                {% for queue in buildInfo.buildings.queue %}
                    <div class="queue-next">
                        <span>{{ queue.name }} ({{ queue.level }})</span>
                        <a href="game.php?page=buildings&cmd=remove&listid={{ loop.index }}" class="remove-btn"><i class="fas fa-times"></i></a>
                    </div>
                {% endfor %}
                </div>
            {% endif %}

            {% else %}
            <div class="empty-state">{{ LNG.ov_free }}</div>
            {% endif %}
        </div>

        {% if buildInfo.tech %}
        <div class="glass-panel ops-panel">
            <div class="panel-header"><i class="fas fa-flask"></i> {{ LNG.ov_research_queue }}</div>
            <div class="queue-item active-research">
                <div class="queue-info">
                    <span class="build-name">{{ buildInfo.tech.name }} ({{ buildInfo.tech.level }})</span>
                    <span class="build-timer" id="rs_vector" data-time="{{ buildInfo.tech.timeleft }}">-</span>
                </div>
                <div class="progress-track">
                     <div class="progress-bar bar-research" id="rs_progressbar" data-time="{{ buildInfo.tech.timeleft }}" data-total="{{ buildInfo.tech.starttime }}"></div>
                </div>
            </div>
        </div>
        {% endif %}
        
        {% if buildInfo.fleet %}
        <div class="glass-panel ops-panel">
             <div class="panel-header"><i class="fas fa-wrench"></i> {{ LNG.ov_shipyard_queue }}</div>
             <div class="queue-item active-hangar">
                <div class="queue-info">
                    <span class="build-name">{{ buildInfo.fleet.name }} ({{ buildInfo.fleet.amount }})</span>
                     <span class="build-timer" id="werk_vector" data-time="{{ buildInfo.fleet.timeleft }}">-</span>
                </div>
                 <div class="progress-track">
                     <div class="progress-bar bar-hangar" id="werk_progressbar" data-time="{{ buildInfo.fleet.timeleft }}" data-total="{{ buildInfo.fleet.starttime }}"></div>
                </div>
            </div>
        </div>
        {% endif %}

    </div>

    <div class="dashboard-col-right">
        
        <div class="glass-panel info-panel">
            <div class="info-row">
                 <span><i class="fas fa-users"></i> {{ LNG.ov_online_user }}</span>
                 <span class="highlight">{{ onlineUser }}</span>
            </div>
            <div class="info-row">
                 <a href="game.php?page=ticket" class="btn-ticket"><i class="fas fa-life-ring"></i> {{ LNG.ov_ticket }}</a>
            </div>
        </div>

        {% if news %}
        <div class="glass-panel news-panel">
            <div class="panel-header"><i class="fas fa-newspaper"></i> {{ LNG.ov_news }}</div>
            <div class="news-content">
                {{ news|raw }}
            </div>
        </div>
        {% endif %}

        {% if ref_active %}
        <div class="glass-panel ref-panel">
            <div class="panel-header">{{ LNG.ov_reflink }}</div>
             <input type="text" value="{{ path }}index.php?ref={{ userid }}" readonly class="ref-input" onclick="this.select()">
        </div>
        {% endif %}

    </div>

</div>

<script type="text/javascript">
$(function() {
    // Inject Timer logic compatible with AeroSpace Theme
    // Note: Standard 2Moons tickers work via ID. 
    // We ensure IDs like blc_vector matches the JS.
    
    // Custom Progress Bar Logic
    function updateProgress(id, duration, total) {
        // Simple logic placeholder - usually handled by Game JS
        // We added data-attributes for CSS animations if needed
    }
});
</script>
{% endblock %}