{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_messages }}{% endblock %}
{% block content %}

<div class="content_page">
    <div class="aerospace-wrapper">
        
        <div class="glass-panel header-panel">
            <h2 class="page-title"><i class="fas fa-satellite-dish"></i> {{ LNG.mg_overview }}</h2>
            <span id="loading" style="display:none; color: var(--primary); font-weight: bold;">
                <i class="fas fa-spinner fa-spin"></i> {{ LNG.loading }}
            </span>
        </div>

        <div class="msg-category-grid">
            {% for CategoryID, CategoryRow in CategoryList %}
            <div class="msg-cat-card" onclick="Message.getMessages({{ CategoryID }});return false;" style="border-color: {{ CategoryRow.color }};">
                
                <div class="cat-icon" style="color: {{ CategoryRow.color }};">
                    {% if CategoryID == 0 %}<i class="fas fa-eye"></i>
                    {% elseif CategoryID == 1 %}<i class="fas fa-crosshairs"></i>
                    {% elseif CategoryID == 2 %}<i class="fas fa-users"></i>
                    {% elseif CategoryID == 3 %}<i class="fas fa-exclamation-triangle"></i>
                    {% elseif CategoryID == 4 %}<i class="fas fa-cogs"></i>
                    {% elseif CategoryID == 5 %}<i class="fas fa-truck"></i>
                    {% else %}<i class="fas fa-envelope"></i>{% endif %}
                </div>

                <div class="cat-info">
                    <h3 class="cat-title" style="color: {{ CategoryRow.color }};">{{ LNG.mg_type[CategoryID] }}</h3>
                    <div class="cat-stats">
                        <span class="total">{{ LNG.mg_total }}: {{ CategoryRow.total }}</span>
                        {% if CategoryRow.unread > 0 %}
                        <span class="unread pulse">
                            {{ LNG.mg_unread }}: <b>{{ CategoryRow.unread }}</b>
                        </span>
                        {% else %}
                        <span class="read">-</span>
                        {% endif %}
                    </div>
                </div>

            </div>
            {% endfor %}
        </div>
        
        {% if viewList %}
        <div class="glass-panel" style="margin-top: 20px;">
            <div class="panel-title">{{ LNG.mg_game_operators }}</div>
            <div class="operator-list">
                {% for OperatorName, OperatorEmail in viewList %}
                <div class="operator-item">
                    <i class="fas fa-user-shield"></i>
                    <span class="op-name">{{ OperatorName }}</span>
                    <a href="mailto:{{ OperatorEmail }}" class="op-mail" title="{{ LNG.mg_write_mail_to_ops }} {{ OperatorName }}">
                        <i class="fas fa-envelope"></i>
                    </a>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

    </div>
</div>

<style>
/* MESSAGE OVERVIEW STYLES */
.aerospace-wrapper { width: 100%; padding: 15px; box-sizing: border-box; }

.header-panel { 
    display: flex; justify-content: space-between; align-items: center; 
    padding: 15px 25px; margin-bottom: 25px; 
    background: rgba(16, 20, 28, 0.8); border: 1px solid rgba(0, 243, 255, 0.2); 
    border-radius: 8px; box-shadow: 0 0 15px rgba(0,0,0,0.5);
}
.page-title { margin: 0; color: #fff; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 2px; }

/* Grid */
.msg-category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
}

/* Category Card */
.msg-cat-card {
    background: rgba(22, 27, 38, 0.9);
    border: 1px solid rgba(255,255,255,0.1); /* Fallback */
    border-left-width: 4px; /* Colored accent on left */
    border-radius: 8px;
    padding: 20px;
    display: flex; align-items: center; gap: 20px;
    cursor: pointer;
    transition: all 0.2s;
}

.msg-cat-card:hover {
    transform: translateX(5px);
    background: rgba(30, 35, 50, 1);
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

.cat-icon { font-size: 2rem; opacity: 0.8; }
.cat-info { flex: 1; }
.cat-title { margin: 0 0 5px 0; font-size: 1.1rem; text-transform: uppercase; }

.cat-stats { display: flex; justify-content: space-between; font-size: 0.85rem; color: #aaa; }
.unread { color: #e74c3c; font-weight: bold; }
.pulse { animation: pulse-red 2s infinite; }

/* Operator List */
.panel-title { border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; margin-bottom: 10px; color: #fff; font-weight: bold; }
.operator-list { display: flex; gap: 15px; flex-wrap: wrap; }
.operator-item { 
    background: rgba(255,255,255,0.05); padding: 8px 15px; border-radius: 20px; 
    display: flex; align-items: center; gap: 10px; color: #fff; 
}
.op-mail { color: #3498db; transition: 0.2s; }
.op-mail:hover { color: #fff; transform: scale(1.2); }

@keyframes pulse-red {
    0% { text-shadow: 0 0 0 rgba(231, 76, 60, 0.4); }
    50% { text-shadow: 0 0 10px rgba(231, 76, 60, 1); }
    100% { text-shadow: 0 0 0 rgba(231, 76, 60, 0.4); }
}

@media (max-width: 600px) {
    .msg-category-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}