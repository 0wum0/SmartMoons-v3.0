{% block content %}
<div class="aerospace-battle-log">
    
    <div class="battle-result {% if Raport.result == "a" %}win{% elseif Raport.result == "r" %}lose{% else %}draw{% endif %}">
        <div class="result-title">
            {% if Raport.result == "a" %}{{ LNG.sys_attacker_won }}
            {% elseif Raport.result == "r" %}{{ LNG.sys_defender_won }}
            {% else %}{{ LNG.sys_both_won }}{% endif %}
        </div>
        <div class="result-time">{{ Raport.time }}</div>
    </div>

    {% for Round, RoundInfo in Raport.rounds %}
    <div class="battle-round">
        <div class="round-header">Runde {{ Round }}</div>
        
        <div class="fleet-block attacker">
            {% for Player in RoundInfo.attacker %}
            {% set PlayerInfo = Raport.players[Player.userID] %}
            <div class="player-fleet">
                <div class="player-name">{{ PlayerInfo.name }} <span class="coords">[{{ PlayerInfo.koords[0] }}:{{ PlayerInfo.koords[1] }}:{{ PlayerInfo.koords[2] }}]</span></div>
                <div class="player-tech">Weap: {{ PlayerInfo.tech[0] }}% | Shld: {{ PlayerInfo.tech[1] }}% | Armr: {{ PlayerInfo.tech[2] }}%</div>
                
                {% if Player.ships %}
                <table class="fleet-table">
                    <tr><th>Typ</th><th>Anzahl</th><th>Waffen</th><th>Schild</th><th>Hülle</th></tr>
                    {% for ShipID, ShipData in Player.ships %}
                    <tr>
                        <td>{{ LNG.shortNames[ShipID] }}</td>
                        <td>{{ ShipData[0]|number_format }}</td>
                        <td>{{ ShipData[1]|number_format }}</td>
                        <td>{{ ShipData[2]|number_format }}</td>
                        <td>{{ ShipData[3]|number_format }}</td>
                    </tr>
                    {% endfor %}
                </table>
                {% else %}
                <div class="destroyed">{{ LNG.sys_destroyed }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>

        <div class="vs-divider">VS</div>

        <div class="fleet-block defender">
            {% for Player in RoundInfo.defender %}
            {% set PlayerInfo = Raport.players[Player.userID] %}
            <div class="player-fleet">
                <div class="player-name">{{ PlayerInfo.name }} <span class="coords">[{{ PlayerInfo.koords[0] }}:{{ PlayerInfo.koords[1] }}:{{ PlayerInfo.koords[2] }}]</span></div>
                <div class="player-tech">Weap: {{ PlayerInfo.tech[0] }}% | Shld: {{ PlayerInfo.tech[1] }}% | Armr: {{ PlayerInfo.tech[2] }}%</div>
                
                {% if Player.ships %}
                <table class="fleet-table">
                    <tr><th>Typ</th><th>Anzahl</th><th>Waffen</th><th>Schild</th><th>Hülle</th></tr>
                    {% for ShipID, ShipData in Player.ships %}
                    <tr>
                        <td>{{ LNG.shortNames[ShipID] }}</td>
                        <td>{{ ShipData[0]|number_format }}</td>
                        <td>{{ ShipData[1]|number_format }}</td>
                        <td>{{ ShipData[2]|number_format }}</td>
                        <td>{{ ShipData[3]|number_format }}</td>
                    </tr>
                    {% endfor %}
                </table>
                {% else %}
                <div class="destroyed">{{ LNG.sys_destroyed }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    {% endfor %}

    <div class="battle-footer glass-panel">
        {% if Raport.result == "a" %}
        <div class="loot-section">
            <h4>{{ LNG.sys_stealed_ressources }}</h4>
            <div class="res-list">
                {% for elementID, amount in Raport.steal %}
                <span class="res-loot"><img src="{{ dpath }}images/{{ elementID }}.gif" width="20"> {{ amount|number_format }}</span>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="debris-section">
            <h4>{{ LNG.debree_field_1 }}</h4>
            <div class="res-list">
                {% for elementID, amount in Raport.debris %}
                <span class="res-loot"><img src="{{ dpath }}images/{{ elementID }}.gif" width="20"> {{ amount|number_format }}</span>
                {% endfor %}
            </div>
        </div>
        
        <div class="losses-section">
            <div>{{ LNG.sys_attacker_lostunits }}: <span class="red">{{ Raport['units'][0]|number_format }}</span></div>
            <div>{{ LNG.sys_defender_lostunits }}: <span class="red">{{ Raport['units'][1]|number_format }}</span></div>
        </div>
    </div>

</div>

<style>
.aerospace-battle-log { color: #ccc; padding: 20px; font-family: 'Segoe UI', Tahoma, sans-serif; background: #05080e; min-height: 100vh; }

.battle-result { text-align: center; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.1); }
.battle-result.win { background: rgba(46, 204, 113, 0.1); border-color: #2ecc71; }
.battle-result.lose { background: rgba(231, 76, 60, 0.1); border-color: #e74c3c; }
.battle-result.draw { background: rgba(241, 196, 15, 0.1); border-color: #f1c40f; }
.result-title { font-size: 1.5rem; font-weight: bold; text-transform: uppercase; margin-bottom: 5px; color: #fff; }

.battle-round { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); margin-bottom: 20px; border-radius: 8px; overflow: hidden; }
.round-header { background: rgba(0, 243, 255, 0.1); color: #00f3ff; padding: 10px; text-align: center; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; }

.fleet-block { padding: 15px; }
.fleet-block.attacker { border-left: 3px solid #e74c3c; }
.fleet-block.defender { border-left: 3px solid #3498db; }

.player-fleet { margin-bottom: 15px; }
.player-name { color: #fff; font-weight: bold; font-size: 1.1rem; }
.coords { color: #888; font-size: 0.9rem; }
.player-tech { font-size: 0.8rem; color: #aaa; margin-bottom: 5px; }

.fleet-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.fleet-table th { text-align: left; color: #888; border-bottom: 1px solid rgba(255,255,255,0.1); padding: 5px; }
.fleet-table td { border-bottom: 1px solid rgba(255,255,255,0.03); padding: 5px; color: #ccc; }

.vs-divider { text-align: center; font-weight: bold; color: #555; font-style: italic; letter-spacing: 5px; padding: 5px; background: #000; }
.destroyed { color: #e74c3c; font-weight: bold; padding: 10px; font-style: italic; }

.battle-footer { padding: 20px; background: rgba(255,255,255,0.03); border-radius: 8px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.res-list { display: flex; gap: 15px; flex-wrap: wrap; }
.res-loot { display: flex; align-items: center; gap: 5px; color: #fff; font-weight: bold; }
.red { color: #e74c3c; }
h4 { color: #00f3ff; margin: 0 0 10px 0; text-transform: uppercase; font-size: 0.9rem; }
</style>
{% endblock %}