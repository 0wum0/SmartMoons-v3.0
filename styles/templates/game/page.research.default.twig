{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_research }}{% endblock %}
{% block content %}

<div class="content_page">
    <div class="aerospace-wrapper">
        
        <div class="glass-panel header-panel">
            <h2 class="page-title"><i class="fas fa-flask"></i> {{ LNG.lm_research }}</h2>
        </div>

        <div class="build-grid">
            {% for ID, Element in ResearchList %}
            <div class="build-card {% if not Element.buyable %}locked{% endif %}">
                
                <div class="card-visual">
                    <img src="{{ dpath }}gebaeude/{{ ID }}.gif" class="tech-img" alt="{{ LNG.tech[ID] }}" onclick="return Dialog.info({{ ID }})">
                    <div class="level-badge">{{ Element.level }}</div>
                </div>

                <div class="card-info">
                    <div class="card-header">
                        <div class="tech-name" onclick="return Dialog.info({{ ID }})">{{ LNG.tech[ID] }}</div>
                        {% if Element.maxLevel != 255 %}
                        <div class="max-lvl">Max: {{ Element.maxLevel }}</div>
                        {% endif %}
                    </div>
                    
                    <div class="resource-cost">
                        {% for RessID, RessAmount in Element.costResources %}
                        <div class="res-item {% if Element.costOverflow[RessID] == 0 %}ok{% else %}missing{% endif %}">
                            <img src="{{ dpath }}images/{{ RessID }}.gif" alt="">
                            <span>{{ RessAmount|number_format }}</span>
                        </div>
                        {% endfor %}
                    </div>

                    <div class="build-time">
                        <i class="far fa-clock"></i> {{ Element.elementTime|time }}
                    </div>

                    <div class="card-action">
                        {% if Element.maxLevel == Element.levelToBuild %}
                            <span class="status-done">{{ LNG.bd_maxlevel }}</span>
                        {% elseif IsLabinBuild or IsResearchInProgress %}
                             {% if IsLabinBuild %}
                                <span class="status-warn">{{ LNG.bd_building_lab }}</span>
                             {% else %}
                                <span class="status-warn">{{ LNG.bd_working }}</span>
                             {% endif %}
                        {% elseif Element.buyable %}
                            <form action="game.php?page=research" method="post" class="build-form">
                                <input type="hidden" name="cmd" value="insert">
                                <input type="hidden" name="tech" value="{{ ID }}">
                                <button type="submit" class="btn-build">
                                    {% if Element.level == 0 %}
                                        {{ LNG.bd_research }}
                                    {% else %}
                                        {{ LNG.bd_research_next_level }} {{ Element.levelToBuild + 1 }}
                                    {% endif %}
                                </button>
                            </form>
                        {% else %}
                            <span class="status-locked">{{ LNG.bd_tech_blocked }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
/* Nutzt dieselben Styles wie Buildings (damit es konsistent ist) */
.aerospace-wrapper { width: 100%; padding: 15px; box-sizing: border-box; }
.header-panel { padding: 20px; margin-bottom: 25px; background: rgba(16, 20, 28, 0.8); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 8px; display: flex; align-items: center; }
.page-title { margin: 0; color: #fff; font-size: 1.5rem; text-transform: uppercase; }

.build-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }

.build-card {
    background: rgba(22, 27, 38, 0.9);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    overflow: hidden;
    transition: 0.3s;
    display: flex; flex-direction: column;
}
.build-card:hover { transform: translateY(-5px); border-color: rgba(0, 243, 255, 0.3); box-shadow: 0 10px 20px rgba(0,0,0,0.5); }

.card-visual { position: relative; height: 160px; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,0.05); }
.tech-img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; cursor: pointer; }
.build-card:hover .tech-img { transform: scale(1.1); }
.level-badge { position: absolute; bottom: 10px; right: 10px; background: #00f3ff; color: #000; font-weight: bold; padding: 2px 8px; border-radius: 4px; }

.card-info { padding: 15px; flex: 1; display: flex; flex-direction: column; }
.card-header { display: flex; justify-content: space-between; margin-bottom: 10px; align-items: center; }
.tech-name { font-weight: bold; color: #fff; text-transform: uppercase; cursor: pointer; }
.tech-name:hover { color: #00f3ff; }
.max-lvl { font-size: 0.7rem; color: #666; }

.resource-cost { margin-bottom: 10px; flex: 1; }
.res-item { display: flex; align-items: center; gap: 5px; font-size: 0.85rem; margin-bottom: 3px; }
.res-item img { width: 16px; height: 16px; }
.res-item.missing { color: #e74c3c; }
.res-item.ok { color: #2ecc71; }

.build-time { font-size: 0.8rem; color: #888; margin-bottom: 15px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 5px; }

.btn-build {
    width: 100%; background: linear-gradient(45deg, #00f3ff, #0072ff);
    border: none; padding: 8px; border-radius: 4px; color: #000; font-weight: bold;
    cursor: pointer; transition: 0.2s;
}
.btn-build:hover { box-shadow: 0 0 10px rgba(0, 243, 255, 0.3); }

.status-locked { color: #555; font-style: italic; display: block; text-align: center; }
.status-warn { color: #f1c40f; display: block; text-align: center; }
.status-done { color: #2ecc71; display: block; text-align: center; font-weight: bold; }
</style>
{% endblock %}