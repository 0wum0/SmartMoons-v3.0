{% extends "layout.popup.twig" %}

{% block title %}{{ LNG.fcm_info }}{% endblock %}

{% block content %}
<div class="error-page-wrapper">
    
    <div class="glass-panel error-card">
        
        <div class="error-icon-box">
            <i class="fas fa-exclamation-triangle fa-beat-fade"></i>
        </div>

        <h2 class="error-title">{{ LNG.fcm_info }}</h2>
        
        <div class="error-message">
            {{ message|raw }}
        </div>

        <div class="error-actions">
            {% if redirectButtons %}
                {% for button in redirectButtons %}
                <a href="{{ button.url }}" class="btn-action-glow">{{ button.label }}</a>
                {% endfor %}
            {% else %}
                <a href="game.php?page=overview" class="btn-action-glow btn-back">
                    <i class="fas fa-home"></i> {{ LNG.lm_overview }}
                </a>
            {% endif %}
        </div>

    </div>

</div>

<style>
/* Error Page Specific Styles */
.error-page-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    padding: 20px;
}

.error-card {
    max-width: 500px;
    width: 100%;
    text-align: center;
    border: 1px solid rgba(255, 0, 85, 0.3); /* Red Border */
    box-shadow: 0 0 50px rgba(255, 0, 85, 0.1);
    animation: slideUp 0.5s ease-out;
}

.error-icon-box {
    font-size: 4rem;
    color: var(--danger);
    margin-bottom: 1.5rem;
    text-shadow: 0 0 20px rgba(255, 0, 85, 0.5);
}

.error-title {
    font-family: var(--font-heading);
    color: #fff;
    margin-bottom: 1rem;
    font-size: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.error-message {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    background: rgba(0,0,0,0.2);
    padding: 15px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
}

.error-actions {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.btn-back {
    display: inline-flex; /* Fix for flex alignment */
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 200px;
}

/* Animations */
@keyframes slideUp {
    from { transform: translateY(50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

/* FontAwesome Animation Customization */
.fa-beat-fade {
    --fa-animation-duration: 2s;
    --fa-beat-fade-opacity: 0.4;
    --fa-beat-fade-scale: 1.1;
}
</style>
{% endblock %}