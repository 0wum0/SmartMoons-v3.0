{% include "main.header.twig" with {'bodyclass': 'popup-window'} %}

<script type="text/javascript">
(function() {
    try {
        if (window.parent && window.parent.document) {
            // Wir erstellen einen neuen Style-Block für das Eltern-Fenster
            var styleElement = window.parent.document.createElement('style');
            styleElement.type = 'text/css';
            styleElement.id = 'aerospace-fancybox-override';
            
            // CSS, das den weißen Kasten unsichtbar macht
            var cssCode = `
                /* 1. Den äußeren Rahmen unsichtbar machen */
                #fancybox-outer {
                    background: transparent !important;
                    box-shadow: none !important;
                    -moz-box-shadow: none !important;
                    -webkit-box-shadow: none !important;
                }
                
                /* 2. Den Inhalts-Container unsichtbar machen (nur den Hintergrund/Rahmen) */
                #fancybox-content {
                    background: transparent !important;
                    border: none !important;
                    padding: 0 !important;
                    margin: 0 !important;
                    box-shadow: none !important;
                }

                /* 3. Die Schatten-Grafiken von Fancybox ausblenden */
                .fancybox-bg {
                    display: none !important;
                }

                /* 4. Das Standard-X ausblenden */
                #fancybox-close {
                    display: none !important;
                }
                
                /* 5. Sicherstellen, dass kein weißer Hintergrund durchscheint */
                .fancybox-inner {
                    background: transparent !important;
                }
            `;

            // Style einfügen
            if (styleElement.styleSheet) {
                styleElement.styleSheet.cssText = cssCode; // IE
            } else {
                styleElement.appendChild(window.parent.document.createTextNode(cssCode)); // Andere
            }
            
            // Alten Style entfernen falls vorhanden, um Duplikate zu vermeiden
            var oldStyle = window.parent.document.getElementById('aerospace-fancybox-override');
            if (oldStyle) oldStyle.remove();

            window.parent.document.getElementsByTagName('head')[0].appendChild(styleElement);
        }
    } catch(e) {
        console.log("Access denied to parent window styling: " + e);
    }
})();
</script>

<div class="aerospace-modal-wrapper">
    
    <div class="modal-close-btn" onclick="parent.$.fancybox.close();">
        <i class="fas fa-times"></i>
    </div>

    <div class="modal-content custom-scroll">
        {% block content %}{% endblock %}
    </div>

</div>

<script type="text/javascript">
var LoginConfig = {
    'isMultiUniverse': {{ isMultiUniverse|json_encode|raw }},
    'unisWildcast': {{ unisWildcast|json_encode|raw }},
    'referralEnable' : {{ referralEnable|json_encode|raw }},
    'basePath' : {{ basepath|json_encode|raw }}
};
</script>

<style>
    /* BODY TRANSPARENT */
    html, body.popup-window {
        background: transparent !important;
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    /* DER RAHMEN */
    .aerospace-modal-wrapper {
        position: relative;
        width: 96%; 
        height: 96%;
        margin: 2% auto;
        
        background: rgba(13, 17, 26, 0.95); 
        border: 1px solid rgba(0, 243, 255, 0.3);
        border-radius: 15px;
        box-shadow: 0 0 50px rgba(0,0,0,0.8);
        
        display: flex;
        flex-direction: column;
        backdrop-filter: blur(10px);
        box-sizing: border-box;
    }

    /* INHALT */
    .modal-content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        color: #ccc;
    }

    /* CLOSE BUTTON */
    .modal-close-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 35px;
        height: 35px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 999;
        transition: 0.2s;
        font-size: 1.2rem;
    }
    .modal-close-btn:hover {
        background: #e74c3c;
        border-color: #e74c3c;
        transform: rotate(90deg);
        box-shadow: 0 0 10px rgba(231, 76, 60, 0.5);
    }

    /* SCROLLBAR */
    .custom-scroll::-webkit-scrollbar { width: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: transparent; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #00f3ff; border-radius: 3px; }
</style>

</body>
</html>