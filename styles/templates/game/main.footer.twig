<footer class="game-footer">
    <div class="footer-glass-panel">
        <div class="footer-info">
            &copy; {{ "now"|date("Y") }} <span class="text-highlight">{{ gameName }}</span>
            <span class="separator">&bull;</span>
            Powered by <a href="https://github.com/jkroepke/2Moons" target="_blank" class="footer-link">SmartMoons v3.0</a>
        </div>
        <div class="footer-links">
            <a href="game.php?page=disclamer" class="footer-link"><i class="fas fa-gavel"></i> {{ LNG.menu_disclamer }}</a>
        </div>
    </div>
</footer>

</div> </div> <nav class="mobile-dock">
    <a href="game.php?page=overview" class="dock-item {% if GET.page|default('overview') == 'overview' %}active{% endif %}">
        <div class="icon-box"><i class="fas fa-home"></i></div>
        <span class="label">{{ LNG.lm_overview }}</span>
    </a>
    
    <a href="game.php?page=buildings" class="dock-item {% if GET.page == 'buildings' %}active{% endif %}">
        <div class="icon-box"><i class="fas fa-city"></i></div>
        <span class="label">{{ LNG.lm_buildings }}</span>
    </a>

    <div class="dock-fab-wrapper">
        <a href="game.php?page=fleetTable" class="dock-fab">
            <div class="fab-inner">
                <i class="fas fa-rocket"></i>
            </div>
        </a>
    </div>

    <a href="game.php?page=galaxy" class="dock-item {% if GET.page == 'galaxy' %}active{% endif %}">
        <div class="icon-box"><i class="fas fa-globe"></i></div>
        <span class="label">{{ LNG.lm_galaxy }}</span>
    </a>

    <a href="game.php?page=settings" class="dock-item {% if GET.page == 'settings' %}active{% endif %}">
        <div class="icon-box"><i class="fas fa-cogs"></i></div>
        <span class="label">{{ LNG.lm_options }}</span>
    </a>
</nav>

<div id="dialog" style="display:none;"></div>

<script type="text/javascript">
var LoginConfig = {
    'isMultiUniverse': {{ isMultiUniverse|json_encode|raw }},
    'unisWildcast': {{ unisWildcast|json_encode|raw }},
    'referralEnable' : {{ referralEnable|json_encode|raw }},
    'basePath' : {{ basepath|json_encode|raw }}
};
</script>

{% for cronjob in cronjobs %}
    <img src="cronjob.php?cronjobID={{ cronjob }}" alt="" style="display:none; width:1px; height:1px;">
{% endfor %}

{% if ga_active %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_key }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ ga_key }}');
</script>
{% endif %}

</body>
</html>