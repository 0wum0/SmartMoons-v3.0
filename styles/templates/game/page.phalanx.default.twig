{% extends "layout.popup.twig" %}

{% block title %}{{ LNG.gl_phalanx }}{% endblock %}
{% block content %}

<div class="aerospace-phalanx">

    <div class="phalanx-header">
        <div class="radar-visual">
            <div class="radar-sweep"></div>
            <div class="radar-dot"></div>
        </div>
        <div class="header-info">
            <h2 class="scan-title">{{ LNG.px_scan_position }} [{{ galaxy }}:{{ system }}:{{ planet }}]</h2>
            <div class="scan-target">
                <i class="fas fa-globe"></i> {{ name }}
            </div>
        </div>
    </div>

    <div class="fleet-monitor">
        <div class="monitor-label">{{ LNG.px_fleet_movement }}</div>
        
        <div class="fleet-list custom-scroll">
            {% for index, fleet in fleetTable %}
            <div class="fleet-row">
                <div class="fleet-timer">
                    <i class="far fa-clock"></i>
                    <span id="fleettime_{{ index }}" class="fleets" data-fleet-end-time="{{ fleet.returntime }}" data-fleet-time="{{ fleet.resttime }}">
                        00:00:00
                    </span>
                </div>
                
                <div class="fleet-details">
                    {{ fleet.text|raw }}
                </div>
            </div>
            {% else %}
            <div class="no-activity">
                <i class="fas fa-wifi-slash"></i>
                <span>{{ LNG.px_no_fleet }}</span>
            </div>
            {% endfor %}
        </div>
    </div>

</div>

<style>
/* PHALANX STYLES */

/* Container */
.aerospace-phalanx {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #ccc;
    font-family: 'Segoe UI', Tahoma, sans-serif;
}

/* HEADER MIT RADAR */
.phalanx-header {
    background: rgba(16, 20, 28, 0.9);
    border: 1px solid rgba(0, 243, 255, 0.2);
    border-radius: 8px;
    padding: 15px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    box-shadow: 0 0 20px rgba(0,0,0,0.5);
}

/* Radar Animation CSS */
.radar-visual {
    width: 60px; height: 60px;
    border: 2px solid #00f3ff;
    border-radius: 50%;
    position: relative;
    background: radial-gradient(circle, rgba(0, 243, 255, 0.1), transparent);
    overflow: hidden;
    box-shadow: 0 0 10px #00f3ff;
}
.radar-sweep {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: conic-gradient(from 0deg, transparent 0deg, rgba(0, 243, 255, 0.5) 60deg, transparent 61deg);
    border-radius: 50%;
    animation: radar-spin 2s linear infinite;
}
.radar-dot {
    position: absolute; width: 4px; height: 4px; background: #ff0000; border-radius: 50%;
    top: 20px; right: 20px;
    box-shadow: 0 0 5px #ff0000;
    animation: blink 1s infinite;
}

@keyframes radar-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes blink { 50% { opacity: 0; } }

/* Header Text */
.header-info { flex: 1; }
.scan-title {
    margin: 0 0 5px 0; font-size: 1.2rem; color: #00f3ff; text-transform: uppercase; letter-spacing: 1px;
}
.scan-target { font-size: 1rem; color: #fff; font-weight: bold; }

/* MONITOR & LISTE */
.fleet-monitor {
    flex: 1;
    background: rgba(255,255,255,0.02);
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
    display: flex; flex-direction: column;
    overflow: hidden;
}

.monitor-label {
    background: rgba(255,255,255,0.05);
    padding: 10px 15px;
    font-weight: bold; color: #aaa; text-transform: uppercase; font-size: 0.8rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.fleet-list {
    padding: 10px;
    overflow-y: auto;
    max-height: 400px;
}

/* FLOTTEN ZEILE */
.fleet-row {
    background: rgba(0,0,0,0.3);
    border-left: 3px solid #00f3ff;
    margin-bottom: 10px;
    padding: 10px;
    border-radius: 0 4px 4px 0;
    display: flex;
    align-items: center;
    gap: 15px;
    transition: 0.2s;
}
.fleet-row:hover { background: rgba(0, 243, 255, 0.05); }

.fleet-timer {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    color: #fff;
    background: rgba(0,0,0,0.5);
    padding: 5px 10px;
    border-radius: 4px;
    min-width: 80px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.1);
}

.fleet-details {
    font-size: 0.9rem;
    color: #ddd;
    line-height: 1.4;
}
/* Farben für Links im Text erzwingen */
.fleet-details a { color: #00f3ff; text-decoration: none; }
.fleet-details .friendly { color: #2ecc71; }
.fleet-details .hostile { color: #e74c3c; }

/* LEER STATUS */
.no-activity {
    text-align: center; padding: 40px; color: #555;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.no-activity i { font-size: 2rem; }

</style>
{% endblock %}