{% extends "layout.popup.twig" %}

{% block title %}{{ LNG.lm_info }}{% endblock %}
{% block content %}

<div class="aerospace-info">

    <div class="info-header glass-panel">
        <div class="header-visual">
            <div class="glow-ring">
                <img src="{{ dpath }}gebaeude/{{ elementID }}.{% if elementID >=600 and elementID <= 699 %}jpg{% else %}gif{% endif %}" alt="" class="tech-img">
            </div>
        </div>
        <div class="header-data">
            <h2 class="tech-title">{{ LNG.tech[elementID] }}</h2>
            <div class="tech-desc custom-scroll">
                {{ LNG.longDescription[elementID] }}
            </div>
        </div>
    </div>

    <div class="info-grid">

        {% if Bonus %}
        <div class="info-card">
            <div class="card-head"><i class="fas fa-star"></i> {{ LNG.in_bonus }}</div>
            <div class="bonus-list">
                {% for BonusName, elementBouns in Bonus %}
                <div class="list-row">
                    <span class="label">{{ LNG.bonus[BonusName] }}</span>
                    <span class="value {% if elementBouns[0] < 0 %}neg{% else %}pos{% endif %}">
                        {% if elementBouns[0] >= 0 %}+{% endif %}{% if elementBouns[1] == 0 %}{{ (elementBouns[0] * 100)|abs }}%{% else %}{{ elementBouns[0] }}{% endif %}
                    </span>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if FleetInfo %}
            {% if FleetInfo.rapidfire.to or FleetInfo.rapidfire.from %}
            <div class="info-card wide">
                <div class="card-head"><i class="fas fa-crosshairs"></i> Kampfdaten</div>
                <div class="rf-flex">
                    {% if FleetInfo.rapidfire.to %}
                    <div class="rf-box">
                        <div class="rf-label pos">Stark gegen</div>
                        {% for rapidfireID, shoots in FleetInfo.rapidfire.to %}
                        <div class="rf-row">
                            <span>{{ LNG.tech[rapidfireID] }}</span>
                            <span class="pos">{{ shoots|number_format }}x</span>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {% if FleetInfo.rapidfire.from %}
                    <div class="rf-box">
                        <div class="rf-label neg">Schwach gegen</div>
                        {% for rapidfireID, shoots in FleetInfo.rapidfire.from %}
                        <div class="rf-row">
                            <span>{{ LNG.tech[rapidfireID] }}</span>
                            <span class="neg">{{ shoots|number_format }}x</span>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        {% endif %}

        {% if productionTable.production %}
            <div class="info-card wide">
                {% include "shared.information.production.twig" %}
            </div>
        {% endif %}
        
        {% if productionTable.storage %}
            <div class="info-card wide">
                {% include "shared.information.storage.twig" %}
            </div>
        {% endif %}

        {% if GateData %}<div class="info-card wide">{% include "shared.information.gate.twig" %}</div>{% endif %}
        {% if MissileList %}<div class="info-card wide">{% include "shared.information.missiles.twig" %}</div>{% endif %}

    </div>
</div>

<style>
/* STYLE DEFINITIONEN */
.glass-panel {
    background: rgba(20, 25, 35, 0.85);
    border: 1px solid rgba(0, 243, 255, 0.15);
    border-radius: 8px;
    padding: 15px;
    box-shadow: 0 0 20px rgba(0,0,0,0.5);
    backdrop-filter: blur(5px);
}

/* Header */
.info-header {
    display: flex; gap: 20px; margin-bottom: 20px; align-items: stretch;
    height: 180px; /* Feste Höhe für Layout-Stabilität */
}

.header-visual {
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    width: 160px; background: rgba(0,0,0,0.3); border-radius: 6px;
}
.tech-img { width: 100px; height: 100px; border-radius: 5px; box-shadow: 0 0 15px rgba(0, 243, 255, 0.2); }

.header-data { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.tech-title { margin: 0 0 10px 0; color: #fff; text-transform: uppercase; font-size: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px; }
.tech-desc { flex: 1; overflow-y: auto; color: #aaa; font-size: 0.9rem; line-height: 1.5; padding-right: 5px; }

/* Grid */
.info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 15px; }
.info-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; padding: 10px; }
.info-card.wide { grid-column: 1 / -1; }

.card-head { font-weight: bold; color: #00f3ff; margin-bottom: 10px; text-transform: uppercase; font-size: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 5px; }

/* Lists */
.list-row { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.02); font-size: 0.9rem; }
.pos { color: #2ecc71; }
.neg { color: #e74c3c; }

/* Rapidfire */
.rf-flex { display: flex; gap: 20px; flex-wrap: wrap; }
.rf-box { flex: 1; min-width: 200px; }
.rf-label { font-size: 0.8rem; font-weight: bold; margin-bottom: 5px; text-transform: uppercase; }
.rf-row { display: flex; justify-content: space-between; padding: 3px 0; font-size: 0.85rem; color: #ccc; }

/* Responsive */
@media (max-width: 600px) {
    .info-header { flex-direction: column; height: auto; }
    .header-visual { width: 100%; height: 120px; margin-bottom: 10px; }
    .tech-desc { max-height: 150px; }
}
</style>
{% endblock %}