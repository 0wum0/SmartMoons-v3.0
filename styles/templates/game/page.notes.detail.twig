{% extends "layout.popup.twig" %}

{% block title %}{{ LNG.lm_notes }}{% endblock %}
{% block content %}

<div class="aerospace-form-wrapper">
    <div class="form-header">
        <i class="far fa-edit"></i>
        {% if noteDetail.id == 0 %}{{ LNG.nt_create_note }}{% else %}{{ LNG.nt_edit_note }}{% endif %}
    </div>

    <form action="?page=notes&amp;mode=insert" method="post">
        <input type="hidden" name="id" value="{{ noteDetail.id }}">
        
        <div class="form-group">
            <label>{{ LNG.nt_priority }}</label>
            <div class="priority-selector">
                <input type="radio" name="priority" id="p2" value="2" {% if noteDetail.priority == 2 %}checked{% endif %}>
                <label for="p2" class="prio-btn danger">Wichtig</label>

                <input type="radio" name="priority" id="p1" value="1" {% if noteDetail.priority == 1 %}checked{% endif %}>
                <label for="p1" class="prio-btn warning">Normal</label>

                <input type="radio" name="priority" id="p0" value="0" {% if noteDetail.priority == 0 or noteDetail.priority is not defined %}checked{% endif %}>
                <label for="p0" class="prio-btn success">Unwichtig</label>
            </div>
        </div>

        <div class="form-group">
            <label for="title">{{ LNG.nt_subject_note }}</label>
            <input type="text" id="title" name="title" class="glass-input" maxlength="30" value="{{ noteDetail.title }}" placeholder="Betreff eingeben...">
        </div>

        <div class="form-group">
            <label for="text">
                {{ LNG.nt_note }} 
                <span class="char-counter">(<span id="cntChars">0</span> / 5.000)</span>
            </label>
            <textarea name="text" id="text" class="glass-textarea custom-scroll" rows="10" onkeyup="$('#cntChars').text($(this).val().length);">{{ noteDetail.text }}</textarea>
        </div>

        <div class="form-actions">
            <input type="reset" value="{{ LNG.nt_reset }}" class="btn-reset">
            <input type="submit" value="{{ LNG.nt_save }}" class="btn-save">
        </div>
    </form>
</div>

<script type="text/javascript">
    // Initiale Zeichenzählung
    $(document).ready(function(){
        $('#cntChars').text($('#text').val().length);
    });
</script>

<style>
/* NOTE DETAIL STYLES */
.aerospace-form-wrapper {
    padding: 10px;
    color: #ccc;
}

.form-header {
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; gap: 10px;
}
.form-header i { color: #00f3ff; }

.form-group { margin-bottom: 20px; }
.form-group label { display: block; margin-bottom: 8px; font-size: 0.9rem; color: #aaa; }

/* Inputs */
.glass-input, .glass-textarea {
    width: 100%;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    padding: 10px;
    border-radius: 4px;
    box-sizing: border-box;
    font-family: inherit;
    transition: 0.3s;
}
.glass-input:focus, .glass-textarea:focus {
    border-color: #00f3ff;
    outline: none;
    background: rgba(0,0,0,0.5);
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.1);
}

/* Priority Selector (Radio Buttons styled as buttons) */
.priority-selector { display: flex; gap: 10px; }
.priority-selector input[type="radio"] { display: none; } /* Hide real radios */

.prio-btn {
    flex: 1;
    text-align: center;
    padding: 8px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    cursor: pointer;
    transition: 0.2s;
    background: rgba(255,255,255,0.05);
    font-weight: bold;
    font-size: 0.85rem;
}

/* Colors for Unchecked */
.prio-btn:hover { background: rgba(255,255,255,0.1); }

/* Checked States */
input[id="p2"]:checked + .prio-btn.danger {
    background: rgba(231, 76, 60, 0.2); border-color: #e74c3c; color: #e74c3c; box-shadow: 0 0 10px rgba(231, 76, 60, 0.2);
}
input[id="p1"]:checked + .prio-btn.warning {
    background: rgba(241, 196, 15, 0.2); border-color: #f1c40f; color: #f1c40f; box-shadow: 0 0 10px rgba(241, 196, 15, 0.2);
}
input[id="p0"]:checked + .prio-btn.success {
    background: rgba(46, 204, 113, 0.2); border-color: #2ecc71; color: #2ecc71; box-shadow: 0 0 10px rgba(46, 204, 113, 0.2);
}

/* Actions */
.form-actions { display: flex; justify-content: space-between; margin-top: 20px; }

.btn-reset {
    background: transparent; border: 1px solid rgba(255,255,255,0.2); color: #aaa;
    padding: 8px 20px; border-radius: 4px; cursor: pointer; transition: 0.2s;
}
.btn-reset:hover { border-color: #fff; color: #fff; }

.btn-save {
    background: linear-gradient(45deg, #00f3ff, #0072ff);
    border: none; color: #000; font-weight: bold;
    padding: 8px 30px; border-radius: 4px; cursor: pointer; transition: 0.2s;
}
.btn-save:hover { transform: scale(1.05); box-shadow: 0 0 15px rgba(0, 243, 255, 0.4); }

.char-counter { float: right; font-size: 0.8rem; }
</style>
{% endblock %}